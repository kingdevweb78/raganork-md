#
# === WhatsApp Session ===
# SESSION=RGNK~your_session_here

# === Bot Identity ===
BOT_INFO=Victory Hub;KING DEV;default
BOT_NAME=Victory Hub
HANDLERS=.,!

# === Groq AI (Main AI Engine) ===
# Get free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# === Bot Settings ===
MODE=private
SUDO=919876543210
LANGUAGE=en
TZ=America/Port-au-Prince

# === Database (for cloud deployments) ===
# DATABASE_URL=postgresql://user:pass@host:5432/db

# === Optional ===
# ALIVE=Victory Hub is online! 🚀
# LOG_LEVEL=info
# AUTO_UPDATE=true
